# =====================================================================
#  secrets.tcl  -  Passwords and API keys (copy to secrets.tcl)
# ---------------------------------------------------------------------
#  cp secrets.tcl.example secrets.tcl && chmod 600 secrets.tcl
#  secrets.tcl is in .gitignore: never commit it.
#  It is loaded after the scripts, so these values win over the
#  defaults inside each script.
# =====================================================================

# --- qauth.tcl: the bot's Q account (required) ---
set ::qauth::user "BotAccount"
set ::qauth::pass "BotPassword"
#set ::qauth::hidehost 0    ;# 1 = set +x after auth (hides the IP), 0 = keep the real host

# --- antiproxy.tcl / ipinfo.tcl: free key from https://proxycheck.io ---
set ::antiproxy::proxycheck_key ""

# --- youtube.tcl: YouTube Data API v3 key (optional, enables !yt search) ---
#     https://console.cloud.google.com -> APIs & Services -> YouTube Data API v3
set ::youtube::key ""

# --- github.tcl: GitHub token (optional, 60 -> 5000 requests/hour) ---
#     https://github.com/settings/tokens -> fine-grained, no permissions needed
#set ::github::token ""

# --- ask.tcl: Claude API key from https://console.anthropic.com ---
set ::ask::api_key ""
#     Or a local model through an OpenAI-compatible server (no key):
#set ::ask::provider   "openai"
#set ::ask::openai_url "http://localhost:11434/v1/chat/completions"
#set ::ask::model      "llama3.2"

# --- chanstats.tcl: web page (optional) ---
#set ::chanstats::htmldir "/var/www/html/stats"
#set ::chanstats::htmlurl "https://example.com/stats"
